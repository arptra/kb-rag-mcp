# GigaCode Context offline configuration
# Copy to ~/.context/.env or pass the same values through the GigaCode MCP config.

# This fork accepts only the in-process local Transformers.js provider.
EMBEDDING_PROVIDER=LocalTransformer

# Absolute path to a model directory already copied into the closed contour.
# The directory must contain a Transformers.js-compatible tokenizer/config and ONNX files.
LOCAL_EMBEDDING_MODEL_PATH=/opt/gigacode-context/models/multilingual-e5-small
LOCAL_EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_MAX_TOKENS=2048
LOCAL_EMBEDDING_DTYPE=q8

# Recommended for multilingual-e5 models. Leave empty for models that need no prefixes.
LOCAL_EMBEDDING_QUERY_PREFIX="query: "
LOCAL_EMBEDDING_DOCUMENT_PREFIX="passage: "

# Only loopback endpoints are accepted. Cloud discovery by token is disabled.
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_LITE_COMMAND=/opt/gigacode-context/.venv/bin/milvus-lite
MILVUS_LITE_DATA_DIR=/opt/gigacode-context/.runtime/milvus-lite

EMBEDDING_BATCH_SIZE=32
SPLITTER_TYPE=ast
HYBRID_MODE=true

# Optional additions to the indexed file set.
# CUSTOM_EXTENSIONS=.vue,.svelte,.sql,.yaml,.yml
# CUSTOM_IGNORE_PATTERNS=temp/**,*.backup,private/**

GIGACODE_CONTEXT_BACKGROUND_SYNC=true
GIGACODE_CONTEXT_SYNC_INTERVAL_MS=300000
GIGACODE_CONTEXT_TRIGGER_WATCHER=true
