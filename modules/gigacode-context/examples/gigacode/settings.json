{
  "mcpServers": {
    "gigacode-context": {
      "command": "/opt/node/bin/node",
      "args": [
        "/opt/gigacode-context/packages/mcp/dist/index.js"
      ],
      "env": {
        "EMBEDDING_PROVIDER": "LocalTransformer",
        "LOCAL_EMBEDDING_MODEL_PATH": "/opt/gigacode-context/models/multilingual-e5-small",
        "LOCAL_EMBEDDING_DIMENSION": "384",
        "LOCAL_EMBEDDING_MAX_TOKENS": "2048",
        "LOCAL_EMBEDDING_DTYPE": "q8",
        "LOCAL_EMBEDDING_QUERY_PREFIX": "query: ",
        "LOCAL_EMBEDDING_DOCUMENT_PREFIX": "passage: ",
        "EMBEDDING_BATCH_SIZE": "32",
        "MILVUS_ADDRESS": "127.0.0.1:19530",
        "MILVUS_LITE_COMMAND": "/opt/gigacode-context/.venv/bin/milvus-lite",
        "MILVUS_LITE_DATA_DIR": "/opt/gigacode-context/.runtime/milvus-lite",
        "GIGACODE_CONTEXT_HOME": "/opt/gigacode-context/.runtime",
        "GIGACODE_CONTEXT_BACKGROUND_SYNC": "true"
      }
    }
  }
}
