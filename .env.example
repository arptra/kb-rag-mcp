KB_KNOWLEDGE_DIR=./knowledge
KB_CACHE_DIR=./.cache/kb
# Separate global index containing current SSOTs of every service.
KB_SSOT_ENABLED=false
KB_SSOT_KNOWLEDGE_DIR=./ssot
KB_SSOT_CACHE_DIR=./.cache/ssot
KB_EMBEDDING_PROVIDER=hash
KB_EMBEDDING_MODEL=./models/Qwen3-Embedding-0.6B
KB_EMBEDDING_LOCAL_FILES_ONLY=true
KB_EMBEDDING_DEVICE=auto
KB_EMBEDDING_BATCH_SIZE=8
KB_EMBEDDING_MAX_SEQ_LENGTH=2048
KB_EMBEDDING_DIMENSION=1024
KB_QUERY_INSTRUCTION=Given a technical question about a software system, retrieve relevant corporate knowledge, architecture, requirements, business rules, APIs, events, ADRs and runbooks.
KB_CHUNK_SIZE_TOKENS=700
KB_CHUNK_HARD_MAX_TOKENS=900
KB_CHUNK_OVERLAP_TOKENS=80
# MCP search retrieves 12 candidates internally, then returns up to 3 compact diverse excerpts.
KB_DEFAULT_TOP_K=3
KB_SEARCH_CANDIDATE_K=12
KB_SEARCH_EXCERPT_TOKENS=260
KB_SEARCH_CONTEXT_TOKENS=1000
KB_SEARCH_MAX_CHUNKS_PER_DOCUMENT=1
# Maximum text returned by kb_get_document or kb_get_chunk.
KB_DOCUMENT_CONTEXT_TOKENS=800
# One global current SSOT index uses the same prepared cache and filters these documents by type.
KB_SSOT_DOCUMENT_TYPE=ssot
KB_SSOT_CANDIDATE_K=20
KB_SSOT_MAX_SERVICES=6
KB_SSOT_FACTS_PER_SERVICE=3
KB_SSOT_FACT_TOKENS=100
KB_SSOT_CONTEXT_TOKENS=1000
# The calling MCP client's model generates SSOT; the server only exposes bounded source context.
KB_SSOT_GENERATION_MAX_SOURCE_FILES=12
KB_SSOT_GENERATION_SOURCE_CHARS=48000
# Ready strict profile (800 total / 240 excerpt / 600 detail):
# ./scripts/rag-low-context.sh config
# Optional protected benchmark tool. Generate a separate password with: openssl rand -hex 32
KB_BENCHMARK_QUESTIONS_PATH=./evaluation/questions.json
KB_BENCHMARK_PASSWORD=
KB_BENCHMARK_MAX_QUESTIONS=100
# Optional protection for /admin. Leave empty for password-free local access.
KB_ADMIN_PASSWORD=
KB_ADMIN_MAX_UPLOAD_BYTES=10000000
KB_MANAGED_TOOLS_PATH=./.cache/kb/managed_tools.json
KB_BUILTIN_TOOL_OVERRIDES_PATH=./.cache/kb/builtin_tool_overrides.json
# React admin control plane: index catalog, managed index data, Git checkouts and graph snapshot.
KB_INDEX_CATALOG_PATH=./.cache/kb/index_catalog.json
KB_MANAGED_INDEXES_DIR=./.cache/kb/indexes
KB_REPOSITORY_CACHE_DIR=./.cache/kb/repositories
KB_GRAPH_STORE_PATH=./.cache/kb/system_graph.json
KB_SERVICE_MAP_PATH=./.cache/kb/service_map.json
KB_REPOSITORY_MAX_FILES=10000
KB_REPOSITORY_GIT_TIMEOUT_SECONDS=60
KB_REPOSITORY_ANALYSIS_TIMEOUT_SECONDS=600
KB_INDEX_BUILD_TIMEOUT_SECONDS=600
KB_AUTO_INDEX=false
KB_LOG_LEVEL=INFO
KB_MCP_HTTP_HOST=127.0.0.1
KB_MCP_HTTP_PORT=8000
KB_MCP_HTTP_PATH=/mcp
# Optional Bearer protection for HTTP/MCP. Leave empty for password-free local access.
# When exposed outside a trusted machine, set a random value of at least 32 characters.
KB_MCP_HTTP_BEARER_TOKEN=
