KB_KNOWLEDGE_DIR=./knowledge
KB_CACHE_DIR=./.cache/kb
KB_EMBEDDING_PROVIDER=hash
KB_EMBEDDING_MODEL=./models/Qwen3-Embedding-0.6B
KB_EMBEDDING_LOCAL_FILES_ONLY=true
KB_EMBEDDING_DEVICE=auto
KB_EMBEDDING_BATCH_SIZE=8
KB_EMBEDDING_MAX_SEQ_LENGTH=2048
KB_EMBEDDING_DIMENSION=1024
KB_QUERY_INSTRUCTION=Given a technical question about a software system, retrieve relevant corporate knowledge, architecture, requirements, business rules, APIs, events, ADRs and runbooks.
KB_CHUNK_SIZE_TOKENS=700
KB_CHUNK_HARD_MAX_TOKENS=900
KB_CHUNK_OVERLAP_TOKENS=80
KB_DEFAULT_TOP_K=5
KB_AUTO_INDEX=false
KB_LOG_LEVEL=INFO
