{
  "mcpServers": {
    "corporate-kb": {
      "command": "REPLACE_WITH_ABSOLUTE_UV_PATH",
      "args": [
        "run",
        "REPLACE_WITH_ABSOLUTE_PATH/corporate_kb_stdio_proxy.py"
      ],
      "env": {
        "CORPORATE_KB_MCP_URL": "http://REPLACE_WITH_SERVER_IP_OR_DOMAIN:8000/mcp",
        "CORPORATE_KB_MCP_TOKEN": "",
        "CORPORATE_KB_MCP_TIMEOUT": "120"
      },
      "timeout": 120000,
      "trust": false
    }
  }
}
